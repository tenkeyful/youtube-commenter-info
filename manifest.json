{
  "manifest_version": 3,
  "name": "YouTube Commenter Info",
  "version": "2.0.0",
  "description": "Displays YouTube comments' information and more below their handles.",
  "author": "winedows",
  "homepage_url": "https://github.com/tenkeyful/youtube-commenter-info",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "messages.js",
        "youtubei.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "messages.js",
        "content/ui.js",
        "content/channel-data.js",
        "content/channel-columns.js",
        "content/profile-card-data.js",
        "content/profile-card-columns.js",
        "content/comments.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "64": "icon.png",
    "128": "icon.png",
    "256": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{a271ed8b-79b5-4c55-88d4-7ddeb399fb26}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
